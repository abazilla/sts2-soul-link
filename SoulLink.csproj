<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>SoulLink</AssemblyName>
    <ModsPath Condition="'$(ModsPath)' == ''">$(STS2GameDir)\mods</ModsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);issues/**</DefaultItemExcludes>
    <!-- Which game-assembly snapshot to compile against. deploy.sh beta mode passes /p:DllSourceDir=libs/<snapshot>;
         default is the live Steam install. MUST be wired into the Reference HintPaths below, or the override is ignored. -->
    <DllSourceDir Condition="'$(DllSourceDir)' == ''">$(STS2GameDir)/data_sts2_windows_x86_64</DllSourceDir>
    <!-- Pin reference resolution to the HintPath. Without this, RAR's {CandidateAssemblyFiles} can resolve sts2.dll
         from a stale libs/ snapshot (e.g. v0.103.2 lacking INetMessage.ShouldBuffer), silently compiling against the
         wrong interface — the impl then doesn't fill the vtable slot and the mod fails to load at runtime. -->
    <AssemblySearchPaths>{HintPathFromItem};{RawFileName};{TargetFrameworkDirectory}</AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dev-only tests; excluded from release build. Set IncludeTests=true to compile. -->
    <Compile Remove="Tests/**" Condition="'$(IncludeTests)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship locale tables next to the DLL. LocTableLoader reads these via Assembly.Location.
         Extension is .locjson (not .json) so STS2's recursive mod-manifest scanner ignores
         them — loose *.json under mods/ is parsed as a mod manifest and rejected for no 'id'. -->
    <Content Include="Localization\locales\*.locjson">
      <Link>locales\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(DllSourceDir)/sts2.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(DllSourceDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(DllSourceDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Steamworks.NET">
      <HintPath>$(DllSourceDir)/Steamworks.NET.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>
</Project>
